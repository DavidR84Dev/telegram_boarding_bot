# Entorno
APP_ENV=production
LOG_LEVEL=INFO

# Odoo (usuario técnico con permisos sobre reservations.tickets y ir.config_parameter)
# Preferencias -> API Keys: usar la API Key como ODOO_PASSWORD
ODOO_URL=http://127.0.0.1:8079
ODOO_DB=qa2
ODOO_USERNAME=
ODOO_PASSWORD=

# Servidor
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8010

# Los siguientes ajustes NO van en .env: se leen del registro activo del modelo
# bot.telegram.config (Odoo, módulo programacion_operativos) al arrancar:
#   token              token de @BotFather
#   webhook_secret     openssl rand -hex 32
#   public_domain      dominio público del bot, p. ej. bot.ejemplo.com
#   internal_token     openssl rand -hex 32 (el mismo valor que usa Odoo)
#   odoo_public_url    base pública de Odoo para el QR, p. ej. https://odoo.ejemplo.com
